      "css": ".ds-card{display:block;position:relative;aspect-ratio:4/3;width:280px;background:var(--foreground,#0C0C0C);color:var(--background,#F0F0F0);overflow:hidden;font-family:var(--font-geist-mono, \"Geist Mono\"),monospace;}.ds-placeholder{position:absolute;inset:0;display:grid;place-items:center;font-size:12px;text-transform:uppercase;opacity:.4}.ds-overlay{position:absolute;inset:0;padding:24px;display:flex;flex-direction:column;justify-content:flex-end;opacity:0;font-size:14px;text-transform:uppercase;background:#0c0c0c99;transition:opacity .3s}.ds-overlay small{font-size:12px;margin:8px 0 16px;text-transform:none}.ds-tag{font-size:10px;border:1px solid #f0f0f04d;padding:2px 8px;align-self:flex-start}.ds-card:hover .ds-overlay,.ds-card:focus-visible .ds-overlay{opacity:1}.ds-card:focus-visible{outline:2px solid currentColor;outline-offset:4px}"
    },
