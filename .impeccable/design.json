      "html": "<nav class=\"ds-nav\"><a href=\"/lab\">Lab</a><a href=\"/about\">About</a></nav>",
      "css": ".ds-nav{display:flex;gap:32px;font-family:var(--font-geist-mono, \"Geist Mono\"),monospace;}.ds-nav a{padding:4px 8px;color:var(--foreground,#0C0C0C);background:var(--background,#F0F0F0);text-decoration:none;font-size:12px;text-transform:uppercase;letter-spacing:.025em;transition:all .3s cubic-bezier(.61,1,.88,1)}.ds-nav a:hover{background:var(--foreground,#0C0C0C);color:var(--background,#F0F0F0)}.ds-nav a:focus-visible{outline:2px solid currentColor;outline-offset:4px}"
